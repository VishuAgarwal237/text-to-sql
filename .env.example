# Copy to .env and fill in. NEVER commit .env (it is gitignored).

# --- LLM backend -------------------------------------------------------------
# "litellm" (real models) or "stub" (offline deterministic demo, no key needed).
LLM_BACKEND=litellm
# Default model (LiteLLM id). Examples:
#   anthropic/claude-sonnet-5
#   anthropic/claude-haiku-4-5
#   fireworks_ai/accounts/fireworks/models/llama-v3p1-70b-instruct
DEFAULT_MODEL=anthropic/claude-sonnet-5

# --- Provider API keys (set the ones you use) --------------------------------
ANTHROPIC_API_KEY=
FIREWORKS_API_KEY=
OPENAI_API_KEY=

# --- Execution backend -------------------------------------------------------
# "direct" (in-process read-only SQLite) or "mcp" (read-only SQLite MCP server).
EXEC_BACKEND=direct

# --- Eval / observability ----------------------------------------------------
BRAINTRUST_API_KEY=
# Comma-separated model registry keys to benchmark (see app/llm.py MODEL_REGISTRY).
EVAL_MODELS=fireworks-llama-70b,claude-haiku-4-5,claude-sonnet-5

# --- Database ----------------------------------------------------------------
CHINOOK_DB_PATH=data/Chinook.db
